{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": ["react", "react-dom"],
    "paths": {
      "@/*": ["../eventos/src/*"],
      "next/link": ["./src/shim/link.tsx"],
      "next/navigation": ["./src/shim/navegacion.ts"]
    },
    "baseUrl": "."
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "../eventos/src/**/*.ts", "../eventos/src/**/*.tsx"],
  "exclude": ["node_modules"]
}
